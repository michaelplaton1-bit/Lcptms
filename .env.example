# Optional StormGeo connector. Leave blank until credentials are available.
STORMGEO_APP_KEY=
STORMGEO_BASE_URL=https://webapi.stormgeo.com

# Future secure read-only Lake Charles Pilots schedule connector.
LCP_SCHEDULE_BASE_URL=https://lakecharlespilots.com
LCP_SCHEDULE_USERNAME=
LCP_SCHEDULE_PASSWORD=

# Required private access and learning collector settings.
LCPTMS_ADMIN_KEY=
LCPTMS_LEARNING_SECRET=

# Optional. When omitted, learning data encryption derives from the learning secret.
LCPTMS_LEARNING_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=
